# Privy Embedded Wallets (Monad Testnet)
NEXT_PUBLIC_PRIVY_APP_ID=cl_demo_partylot_app_id25
PRIVY_APP_SECRET=your_privy_app_secret

# Pimlico Paymaster (ERC-4337 Sponsored Gas on Monad)
NEXT_PUBLIC_PIMLICO_API_KEY=pim_demo_api_key

# QuickNode RPC (Metropolis Build Plan)
NEXT_PUBLIC_MONAD_RPC_URL=https://monad-testnet.quiknode.pro/your-api-key/
NEXT_PUBLIC_MONAD_WSS_URL=wss://monad-testnet.quiknode.pro/your-api-key/

# Tenderly Pro Simulation Engine
TENDERLY_ACCESS_KEY=your_tenderly_access_key
TENDERLY_ACCOUNT_SLUG=your_account_slug
TENDERLY_PROJECT_SLUG=partylot-monad

# Envio HyperIndex GraphQL Endpoint
NEXT_PUBLIC_ENVIO_GRAPHQL_URL=https://indexer.envio.dev/v1/graphql
